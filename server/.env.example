PORT="SERVER_PORT"

PGHOST="DB_HOST"
PGPORT="DB_PORT"
PGUSER="DB_USER"
PGPASSWORD="YOUR_PASSWORD"
PGDATABASE="DB_NAME"

# Generate one with this command:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="SESSION_SECRET"

#Default Local URL
APP_URL="http://localhost:5173"

# Object storage (S3-compatible API). Local development uses SeaweedFS.
S3_ENDPOINT="S3_ENDPOINT"
S3_REGION="S3_REGION"
S3_ACCESS_KEY_ID="S3_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="S3_SECRET_KEY"
S3_BUCKET="S3_BUCKET_NAME"
S3_FORCE_PATH_STYLE="true"
# "/api/media" in local development (served by the server), or the public domain of the bucket online
MEDIA_PUBLIC_URL="MEDIA_PUBLIC_URL"
